---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign entries = site.html_pages -%}
{%- assign collections = site.collections | where: "output", true -%}
{%- for collection in collections -%}
    {%- assign entries = entries | concat: collection.docs -%}
{%- endfor -%}
{%- assign entries = entries | where_exp: "entry", "entry.sitemap != false" -%}
{%- for entry in entries %}
    {%- if entry.robots contains "noindex" %}{% continue %}{% endif %}
    <url>
        <loc>{{ entry.canonical_url | default: entry.url | absolute_url | xml_escape }}</loc>
        {%- if entry.last_modified_at %}
        <lastmod>{{ entry.last_modified_at | date_to_xmlschema }}</lastmod>
        {%- endif %}
        {%- if entry.translation_key %}
            {%- assign translations = entries | where: "translation_key", entry.translation_key -%}
            {%- for translation in translations %}
                {%- if translation.robots contains "noindex" %}{% continue %}{% endif %}
        <xhtml:link rel="alternate" hreflang="{{ translation.lang }}" href="{{ translation.canonical_url | default: translation.url | absolute_url | xml_escape }}" />
                {%- if translation.lang == "fr" %}
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ translation.canonical_url | default: translation.url | absolute_url | xml_escape }}" />
                {%- endif -%}
            {%- endfor -%}
        {%- endif %}
    </url>
{%- endfor %}
</urlset>
